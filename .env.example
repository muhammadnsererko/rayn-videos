DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=rayn-stream-api
CORS_ALLOWED_ORIGINS=http://localhost:5173
RESEND_API_KEY=your-resend-api-key
MAIL_FROM_EMAIL=verified-sender@your-domain.example
MAIL_FROM_NAME=RAYN STREAM
FRONTEND_URL=https://your-frontend-domain.example

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-private-video-bucket
VIDEO_MAX_UPLOAD_BYTES=1000000000
IMAGE_MAX_UPLOAD_BYTES=5000000
R2_MULTIPART_THRESHOLD_BYTES=67108864
R2_MULTIPART_PART_SIZE_BYTES=16777216
# Local integration tests only; normally leave these unset.
# R2_ENDPOINT=http://127.0.0.1:9000
# R2_PATH_STYLE_ENDPOINT=true